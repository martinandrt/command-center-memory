{
  "permissions": {
    "allow": [
      "Bash(bash scripts/boot.sh)",
      "Bash(python3 scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.claude/.env)"
    ]
  }
}
